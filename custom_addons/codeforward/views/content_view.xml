<odoo>
    <record id="codeforward.view_content_list" model="ir.ui.view">
        <field name="name">view.codeforward.device.content.list.view</field>
        <field name="model">codeforward.device.content</field>
        <field name="arch" type="xml">
            <list>
                <field name="content_id"/>
                <field name="name"/>
                <field name="description"/>
                <field name="device_id"/>
                <field name="expire_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_codeforward_device_content" model="ir.actions.act_window">
        <field name="name">Content</field>
        <field name="res_model">codeforward.device.content</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>